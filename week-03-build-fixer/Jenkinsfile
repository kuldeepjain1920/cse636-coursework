// Build-fixer pipeline — adapted for kuldeepjain1920/cse636-coursework
// (week-03-build-fixer/ subfolder), full "open a real PR" flow.
//
// Clones YOUR OWN repo, runs the buggy tests inside week-03-build-fixer/,
// and on a red build the agent opens a no-merge PR with the proposed fix. A human
// reviews/merges the PR on GitHub, then clicks Proceed at the approval gate.
//
// Credentials required (Manage Jenkins -> Credentials -> System -> Global):
//   - ANTHROPIC_API_KEY  (Secret text)             the Anthropic API key
//   - github-token       (Secret text)             your PAT with `repo` scope (agent opens the PR)
//   - github-https       (Username with password)  your GitHub username + the same PAT (repo checkout)

pipeline {
  agent any

  environment {
    ANTHROPIC_API_KEY = credentials('ANTHROPIC_API_KEY')
    GH_TOKEN          = credentials('github-token')
    REPO              = 'kuldeepjain1920/cse636-coursework'   // <-- your own repo now
    BASE_BRANCH       = 'main'
    GITHUB_RUN_ID     = "${BUILD_NUMBER}"
    MODEL             = 'claude-haiku-4-5'
  }

  stages {
    stage('Checkout') {
      steps {
        git branch: 'main',
            url: 'https://github.com/kuldeepjain1920/cse636-coursework.git',   // <-- your own repo
            credentialsId: 'github-https'
      }
    }

    stage('Test (expect red)') {
      steps {
        dir('week-03-build-fixer') {                       // <-- new subfolder name
          script {
            def rc = sh(script: 'pytest tests/test_calculator.py --tb=short > build_log.txt 2>&1',
                        returnStatus: true)
            sh 'cat build_log.txt'
            env.TESTS_FAILED = (rc != 0) ? 'true' : 'false'
          }
          echo "Tests failed? ${env.TESTS_FAILED}"
        }
      }
    }

    stage('Agent: open PR') {
      when { expression { env.TESTS_FAILED == 'true' } }
      steps {
        sh 'pip install --quiet PyGithub'
        sh '''python week-03-build-fixer/scripts/build_fixer_agent.py --open-pr \
                --log    week-03-build-fixer/build_log.txt \
                --source week-03-build-fixer/src/calculator.py'''
      }
    }

    stage('Human approval gate') {
      when { expression { env.TESTS_FAILED == 'true' } }
      steps {
        timeout(time: 60, unit: 'MINUTES') {
          input message: 'Agent opened a PR. Review & merge it on GitHub, then Proceed to confirm — or Abort.'
        }
      }
    }
  }

  post {
    always { archiveArtifacts artifacts: 'week-03-build-fixer/build_log.txt', allowEmptyArchive: true }
  }
}
